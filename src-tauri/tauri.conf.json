{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OIS Meet",
  "version": "2.0.0",
  "identifier": "com.ois.meet.desktop",
  "build": {
    "frontendDist": "../dist/ois-meet-desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start:tauri",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OIS Meet",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
